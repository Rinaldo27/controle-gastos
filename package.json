{
  "name": "expense-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Controle financeiro pessoal (PWA, Mobile First, JavaScript puro)",
  "license": "UNLICENSED",
  "engines": {
